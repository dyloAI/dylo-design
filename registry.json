{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dylo",
  "homepage": "https://design.dylo.dev",
  "include": ["registry/dylo/registry.json"],
  "items": [
    {
      "name": "brand-assets",
      "type": "registry:item",
      "title": "Brand assets",
      "description": "The dylo mark and logo lockups, black for light surfaces and white for dark, the app icons and the video-call backgrounds, in SVG and PNG. Installs into public/brand/, which is where the Logo component expects them.",
      "files": [
        {
          "path": "public/brand/dylo-mark.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-mark.svg"
        },
        {
          "path": "public/brand/dylo-mark-reversed.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-mark-reversed.svg"
        },
        {
          "path": "public/brand/dylo-mark.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-mark.png"
        },
        {
          "path": "public/brand/dylo-mark-reversed.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-mark-reversed.png"
        },
        {
          "path": "public/brand/dylo-logo-horizontal.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-horizontal.svg"
        },
        {
          "path": "public/brand/dylo-logo-horizontal-reversed.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-horizontal-reversed.svg"
        },
        {
          "path": "public/brand/dylo-logo-horizontal.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-horizontal.png"
        },
        {
          "path": "public/brand/dylo-logo-horizontal-reversed.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-horizontal-reversed.png"
        },
        {
          "path": "public/brand/dylo-logo-stacked.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-stacked.svg"
        },
        {
          "path": "public/brand/dylo-logo-stacked-reversed.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-stacked-reversed.svg"
        },
        {
          "path": "public/brand/dylo-mark-mono.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-mark-mono.svg"
        },
        {
          "path": "public/brand/dylo-mark-mono-reversed.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-mark-mono-reversed.svg"
        },
        {
          "path": "public/brand/dylo-logo-horizontal-mono.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-horizontal-mono.svg"
        },
        {
          "path": "public/brand/dylo-logo-horizontal-mono-reversed.svg",
          "type": "registry:file",
          "target": "~/public/brand/dylo-logo-horizontal-mono-reversed.svg"
        },
        {
          "path": "public/brand/dylo-app-icon.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-app-icon.png"
        },
        {
          "path": "public/brand/dylo-app-icon-reversed.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-app-icon-reversed.png"
        },
        {
          "path": "public/brand/dylo-meet-background-light.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-meet-background-light.png"
        },
        {
          "path": "public/brand/dylo-meet-background-dark.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-meet-background-dark.png"
        },
        {
          "path": "public/brand/dylo-meet-background-light-mirrored.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-meet-background-light-mirrored.png"
        },
        {
          "path": "public/brand/dylo-meet-background-dark-mirrored.png",
          "type": "registry:file",
          "target": "~/public/brand/dylo-meet-background-dark-mirrored.png"
        }
      ]
    },
    {
      "name": "agent-rules",
      "type": "registry:item",
      "title": "Agent rules",
      "description": "The brand rule for Cursor and the ESLint adherence config, so an agent working in a client repo inherits the non-negotiables and the linter catches raw hex, Tailwind's default 50 to 950 palette and emoji.",
      "files": [
        {
          "path": "rules/dylo-brand.mdc",
          "type": "registry:file",
          "target": "~/.cursor/rules/dylo-brand.mdc"
        },
        {
          "path": "rules/eslint.dylo-adherence.mjs",
          "type": "registry:file",
          "target": "~/eslint.dylo-adherence.mjs"
        }
      ]
    }
  ]
}
