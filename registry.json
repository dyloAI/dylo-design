{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dylo",
  "homepage": "https://design.dylo.dev",
  "include": ["registry/dylo/registry.json"],
  "items": [
    {
      "name": "brand-assets",
      "type": "registry:item",
      "title": "Brand assets",
      "description": "The keystone mark, logo lockups and app icons, in SVG and PNG. Installs into public/brand/, which is where the components expect them.",
      "files": [
        { "path": "public/brand/dylo-logo-horizontal.svg", "type": "registry:file", "target": "~/public/brand/dylo-logo-horizontal.svg" },
        { "path": "public/brand/dylo-logo-horizontal.png", "type": "registry:file", "target": "~/public/brand/dylo-logo-horizontal.png" },
        { "path": "public/brand/dylo-logo-horizontal-reversed.svg", "type": "registry:file", "target": "~/public/brand/dylo-logo-horizontal-reversed.svg" },
        { "path": "public/brand/dylo-logo-horizontal-reversed.png", "type": "registry:file", "target": "~/public/brand/dylo-logo-horizontal-reversed.png" },
        { "path": "public/brand/dylo-logo-stacked.svg", "type": "registry:file", "target": "~/public/brand/dylo-logo-stacked.svg" },
        { "path": "public/brand/dylo-mark.svg", "type": "registry:file", "target": "~/public/brand/dylo-mark.svg" },
        { "path": "public/brand/dylo-mark.png", "type": "registry:file", "target": "~/public/brand/dylo-mark.png" },
        { "path": "public/brand/dylo-mark-accent.svg", "type": "registry:file", "target": "~/public/brand/dylo-mark-accent.svg" },
        { "path": "public/brand/dylo-mark-reversed.svg", "type": "registry:file", "target": "~/public/brand/dylo-mark-reversed.svg" },
        { "path": "public/brand/dylo-mark-reversed.png", "type": "registry:file", "target": "~/public/brand/dylo-mark-reversed.png" },
        { "path": "public/brand/dylo-app-icon.png", "type": "registry:file", "target": "~/public/brand/dylo-app-icon.png" },
        { "path": "public/brand/dylo-app-icon-oxide.png", "type": "registry:file", "target": "~/public/brand/dylo-app-icon-oxide.png" }
      ]
    },
    {
      "name": "agent-rules",
      "type": "registry:item",
      "title": "Agent rules",
      "description": "The brand rule for Cursor and the ESLint adherence config, so an agent working in a client repo inherits the non-negotiables and the linter catches raw hex, off-palette colours and emoji.",
      "files": [
        { "path": "rules/dylo-brand.mdc", "type": "registry:file", "target": "~/.cursor/rules/dylo-brand.mdc" },
        { "path": "rules/eslint.dylo-adherence.mjs", "type": "registry:file", "target": "~/eslint.dylo-adherence.mjs" }
      ]
    }
  ]
}
